# lifemaxxing-dashboard — environment variables (copy to .env.local)

# Nutrition goals (optional; defaults shown)
GOAL_CALORIES=2200
GOAL_PROTEIN=160
GOAL_CARBS=240
GOAL_FAT=70

# Whisper voice transcription (optional)
WHISPER_PYTHON=python3
WHISPER_MODEL=base

# Spotify now-playing widget (optional).
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add Redirect URI exactly:  http://127.0.0.1:3000/api/spotify/callback
#    (Spotify requires 127.0.0.1, NOT localhost, for loopback redirects)
# 3. Copy the Client ID / Secret here, then click "Connect Spotify" in the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional override (must match the dashboard URI registered in the Spotify app):
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
